                { label: "Free Trial", href: "/trial" },
                { label: "Official Blog", href: "/blog" },
                { label: "Privacy Policy", href: "#" },
                { label: "Terms of Service", href: "#" },
              ],
            },
          ].map((col) => (
            <div key={col.title}>
              <h4
                style={{
                  color: "#FFFFFF",
                  fontWeight: 700,
                  marginBottom: "1.25rem",
                  fontSize: "0.95rem",
                }}
              >
                {col.title}
              </h4>
              <ul
                style={{
                  listStyle: "none",
                  padding: 0,
                  margin: 0,
                  display: "flex",
                  flexDirection: "column",
                  gap: "0.75rem",
                }}
              >
                {col.links.map((link) => (
                  <li key={link.label}>
                    {link.href.startsWith("/") ? (
                      <Link
                        to={link.href}
                        style={{
                          color: "rgba(255,255,255,0.6)",
                          textDecoration: "none",
                          fontSize: "0.875rem",
                          transition: "color 0.2s",
                        }}
                      >
                        {link.label}
                      </Link>
                    ) : (
                      <a
                        href={link.href}
                        style={{
                          color: "rgba(255,255,255,0.6)",
                          textDecoration: "none",
                          fontSize: "0.875rem",
                          transition: "color 0.2s",
                        }}
                      >
                        {link.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div
          style={{
            borderTop: "1px solid rgba(255,255,255,0.08)",
            paddingTop: "2rem",
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
            flexWrap: "wrap",
            gap: "1rem",
            fontSize: "0.825rem",
            color: "rgba(255,255,255,0.45)",
          }}
        >
          <p style={{ margin: 0 }}>
            © {new Date().getFullYear()} Pivotal ERP Pvt. Ltd. Kathmandu, Nepal.
            All rights reserved.
          </p>
          <div style={{ display: "flex", gap: "1.5rem" }}>
            <Link
              to="/login"
              style={{ color: "#38BDF8", textDecoration: "none" }}
            >
              Staff Portal
            </Link>
            <Link
              to="/trial"
              style={{ color: "#48BB28", textDecoration: "none" }}
            >
              Free Trial
            </Link>
          </div>
        </div>
      </div>
    </footer>
  );
}

// ─── Root Landing Page ───────────────────────────────────────────────────────
export default function LandingPage() {
  const [scrolled, setScrolled] = useState(false);
  const [settings, setSettings] = useState<any>(null);

  useEffect(() => {
    setSettings(mockDB.getSettings());
    const handler = () => setScrolled(window.scrollY > 40);
    window.addEventListener("scroll", handler);
    return () => window.removeEventListener("scroll", handler);
  }, []);

  if (!settings) {
    return <div style={{ background: "#0A1128", minHeight: "100vh" }} />;
  }

  return (
    <main
      style={{
        background: "var(--bg-primary)",
        color: "var(--text-primary)",
        minHeight: "100vh",
        fontFamily:
          '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif',
      }}
    >
      <LandingNav scrolled={scrolled} />
      <HeroSection settings={settings} />
      {settings.landingPageSections?.features !== false && <FeaturesSection />}
      {settings.landingPageSections?.industries !== false && (
        <IndustriesSection />
      )}
      {settings.landingPageSections?.pricing !== false && <PricingSection />}
      <FAQSection />
      <CtaBanner />
      <Footer />
    </main>
  );
}
